#!/usr/bin/env ruby

require 'kexp-playlist'
require 'optparse'

options = {}
OptionParser.new do |parser|
  parser.banner = "Usage: kexp-playlist -s START [-e END] [-t]"
  parser.separator ""
  parser.separator "Print the songs KEXP played between two times, oldest first."
  parser.separator "All dates and times are Pacific time (KEXP's time zone)."
  parser.separator ""
  parser.separator "Options:"
  parser.on("-s", "--start DATE", "Start date or time (required), e.g. 2023-05-03 or \"2023-05-03 07:00\"") do |value|
    options[:start] = value
  end
  parser.on("-e", "--end DATE", "End date or time (default: 24 hours after the start)") do |value|
    options[:end] = value
  end
  parser.on("-t", "--time", "Print the time each song played, labeled PDT or PST") do |value|
    options[:time] = true
  end
  parser.separator ""
  parser.separator "Examples:"
  parser.separator "  kexp-playlist -s 2023-05-03 -t                              All of May 3rd, 2023"
  parser.separator "  kexp-playlist -s \"2023-05-03 07:00\" -e \"2023-05-03 10:00\"   7 AM to 10 AM"
end.parse!

if options[:start].nil?
  puts "Start Date Required"
  exit(1)  
end

Kexp::Playlist::Query.call(options)
