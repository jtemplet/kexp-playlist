#!/usr/bin/env ruby

require 'kexp-playlist'
require 'optparse'

options = {}
OptionParser.new do |parser|
  parser.on("-s", "--start Date", "Start date to fetch playlist") do |value|
    options[:start] = value
  end
  parser.on("-e", "--end Date", "End date to fetch playlist (default: 24 hours after start)") do |value|
    options[:end] = value
  end
  parser.on("-t", "--time", "Print timestamp of each song") do |value|
    options[:time] = true
  end
end.parse!

if options[:start].nil?
  puts "Start Date Required"
  exit(1)  
end

Kexp::Playlist::Query.call(options)
